GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Set AI_PROVIDER=openai to use OpenAI, or groq to keep the existing provider.
# If omitted, a configured OPENAI_API_KEY selects OpenAI; otherwise Groq is used.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SPEECH_MODEL=tts-1
OPENAI_VOICE=nova

# Local development only. On Vercel use libsql://... from Turso instead.
TURSO_DATABASE_URL=file:.data/speakeasy.db
# Required for remote Turso; leave empty for the local file.
TURSO_AUTH_TOKEN=
